# Install private copy as /etc/srvprotianti/server.env, owner root, mode 0600.
# Values here are examples. Fill the real password privately; do not commit the copy.
# These postgres-compat variables require enabled:true in its private config.json.
NODE_ENV=production
SRVPRO_LADDER_PG_HOST=127.0.0.1
SRVPRO_LADDER_PG_PORT=5432
SRVPRO_LADDER_PG_DATABASE=srvpro_1103
SRVPRO_LADDER_PG_USERNAME=srvpro_runtime
SRVPRO_LADDER_PG_PASSWORD=
