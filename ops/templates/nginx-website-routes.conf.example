# Public website/API allow-list, included inside the website server block.
# Derived from the host and plugin routes at the time of the 2026-11 drill
# (ygopro-server.coffee HTTP listener; plugins ladder-web, public-room-web,
# public-replay-web). When a plugin adds a public route, add it here too.
#
# Deliberately NOT forwarded (loopback/SSH only): /api/maintenance/*,
# /api/getrooms, /api/duellog, /api/archive.zip, /api/clearlog,
# /api/replay* (legacy, password in query), /api/message, and any OPTIONS.
# Encoded names are accepted only on the three file prefixes, with a strict
# character set and no encoded control, dot, slash or backslash bytes.

location = / {
    if ($srvpro_raw_path != $uri) { return 404; }
    if ($request_method != GET) {
        add_header Allow GET always;
        return 405;
    }
    include /etc/nginx/srvpro/website-proxy.conf;
}

