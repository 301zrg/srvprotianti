location ^~ /assets/ {
    if ($srvpro_raw_path !~ "^/assets/(?!\.{1,2}$)(?:[A-Za-z0-9._~!'()*+-]|%[0-9A-Fa-f]{2})+$") { return 404; }
    if ($srvpro_raw_path ~* "%(?:[01][0-9a-f]|7f|2e|2f|5c)") { return 404; }
    if ($request_method != GET) {
        add_header Allow GET always;
        return 405;
    }
    include /etc/nginx/srvpro/website-proxy.conf;
}

location ^~ /example_decks/ {
    if ($srvpro_raw_path !~ "^/example_decks/(?!\.{1,2}$)(?:[A-Za-z0-9._~!'()*+-]|%[0-9A-Fa-f]{2})+\.[yY][dD][kK]$") { return 404; }
    if ($srvpro_raw_path ~* "%(?:[01][0-9a-f]|7f|2e|2f|5c)") { return 404; }
    if ($request_method != GET) {
        add_header Allow GET always;
        return 405;
    }
    include /etc/nginx/srvpro/website-proxy.conf;
}

location ^~ /api/public/replay/ {
    if ($srvpro_raw_path !~ "^/api/public/replay/(?!\.{1,2}$)(?:[A-Za-z0-9._~!'()*+-]|%[0-9A-Fa-f]{2})+\.[yY][rR][pP]$") { return 404; }
    if ($srvpro_raw_path ~* "%(?:[01][0-9a-f]|7f|2e|2f|5c)") { return 404; }
    if ($request_method != GET) {
        add_header Allow GET always;
        return 405;
    }
    include /etc/nginx/srvpro/website-proxy.conf;
}

location / { return 404; }
